{
  "scripts": {
    "sync:hot-config": "node ./scripts/fetch-hot-update-config.js",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "cocos:detect": "node ./scripts/cocos_cli.js detect",
    "cocos:build:web": "node ./scripts/cocos_cli.js build \"platform=web-mobile;debug=true\"",
    "cocos:build:web:release": "node ./scripts/cocos_cli.js build \"platform=web-mobile;debug=false;md5Cache=true\"",
    "verify:code": "npm run check:ts && npm run cocos:build:web",
    "agora:token": "node scripts/agora-token-server.js",
    "sync:template": "node scripts/sync-template.js",
    "merge:i18n": "node scripts/merge-i18n.js",
    "sync:h5-game": "node scripts/sync-h5-game.js",
    "sync:proto": "node scripts/sync-proto.js"
  },
  "dependencies": {
    "@types/gapi": "^0.0.43",
    "google-protobuf": "^3.21.0",
    "http-server": "^14.1.1",
    "httpserver": "^0.3.0",
    "ts-md5": "^1.2.11"
  },
  "devDependencies": {
    "@types/node": "^18.0.4",
    "agora-token": "^2.0.5",
    "typescript": "^6.0.3"
  }
}
