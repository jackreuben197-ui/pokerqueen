{
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["es2015", "es2017", "dom"],
    "target": "es5",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "outDir": "temp/vscode-dist",
    "rootDir": "./assets/script",
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "exclude": [
    "back_script",
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "settings",
    "deps"
  ]
}
