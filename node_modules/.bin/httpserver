#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/httpserver@0.3.0/node_modules/httpserver/node_modules:/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/httpserver@0.3.0/node_modules:/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/httpserver@0.3.0/node_modules/httpserver/node_modules:/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/httpserver@0.3.0/node_modules:/Users/zoir/space/dev2.0/olavamos/little-fish/pokerqueen/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../httpserver/httpserver.js" "$@"
else
  exec node  "$basedir/../httpserver/httpserver.js" "$@"
fi
