/**
 * 横屏时候的提示
 *
 * 注意: 软键盘弹出时会压缩 viewport 高度,在 Telegram WebView 中可能让 window.orientation
 * 短暂误报横屏。Update 中先用 isKeyboardLikelyOpen 过滤,再做方向判断。
 */
import Main from '../Main';
import { IUpComponent } from './UpdateComponent';
const { ccclass, property } = cc._decorator;

@ccclass
export default class OrientationComponent implements IUpComponent {
    active: boolean = true;
    // 跟踪键盘状态变化，只在变化时打印诊断（避免每帧刷屏）
    private _lastKeyboardOpen: boolean = false;
    // 防止"即将显示横屏"日志每帧重复打印
    private _lastOrientActive: boolean = false;
    // 键盘弹出期间定期打印诊断（看 viewport 变化后的 canvas 状态）
    private _diagTimer: number = 0;
    // 记录 resizeWithBrowserSize 被强制禁用的次数（静默计数，日志统一输出）
    private _resizeFixCount: number = 0;

    Update(dt: number) {
        if (Main.Orientation == null) {
            return;
        }

        // ⚠️ 强制禁用 cocos 的 resize 监听（每帧静默检测，日志在 logOrientDiag 里统一输出）
        // 不管谁（ProcedureInit.setCCC / cocos 内部）把 resizeWithBrowserSize 设成 true，
        // 下一帧立即覆盖成 false。防止键盘弹出时 cocos 响应 resize 旋转画面。
        const view: any = (window as any).cc?.view;
        if (view && view._resizeWithBrowserSize === true) {
            view.resizeWithBrowserSize(false);
            this._resizeFixCount++;
        }

        const keyboardOpen = this.isKeyboardLikelyOpen();

        // [Orient-Diag] 键盘状态变化时打印完整诊断
        if (keyboardOpen !== this._lastKeyboardOpen) {
            this.logOrientDiag(keyboardOpen ? '键盘弹出' : '键盘收起');
            this._lastKeyboardOpen = keyboardOpen;
            this._diagTimer = 0;
        }

        // 优先级最高: 软键盘弹出时强制隐藏遮罩,跳过方向判断
        if (keyboardOpen) {
            if (Main.Orientation.active) Main.Orientation.active = false;
            this._lastOrientActive = false;
            // [Orient-Diag] 键盘弹出期间每 500ms 打印一次 canvas/cocos 内部状态
            // 定位"viewport 压缩后 cocos 旋转画面 90 度"的根因
            this._diagTimer += dt;
            if (this._diagTimer >= 0.5) {
                this._diagTimer = 0;
                this.logOrientDiag('键盘弹出中');
            }
            return;
        }

        // 真实设备方向判断
        const landscape = this.isDeviceLandscape();

        // [Orient-Diag] 即将显示横屏时打印
        if (landscape && !this._lastOrientActive) {
            this.logOrientDiag('⚠️ 即将显示横屏');
        }
        this._lastOrientActive = landscape;

        if (Main.Orientation.active !== landscape) {
            Main.Orientation.active = landscape;
        }
    }

    /**
     * 打印横屏/键盘诊断日志（CC 层输出，能进 cocos 日志收集器）
     * 包含 H5 层 __TG_FIX_DIAG__ 数据 + CC 层判断值，一次看清整条链路
     */
    private logOrientDiag(reason: string): void {
        const tg = (window as any).Telegram?.WebApp;
        const fixDiag = (window as any).__TG_FIX_DIAG__ || {};
        const canvasEl = document.getElementById('GameCanvas') as HTMLCanvasElement;
        const view: any = (window as any).cc?.view;
        console.log('[Orient-Diag]', reason, JSON.stringify({
            // H5 层状态
            h5Registered: fixDiag.registered,
            h5StableHeight: fixDiag.stableHeight,
            h5FocusinCount: fixDiag.focusinCount,
            h5FocusoutCount: fixDiag.focusoutCount,
            // CC 层判断值
            tgFlag: (window as any).__TG_KEYBOARD_OPEN__,
            innerW: window.innerWidth,
            innerH: window.innerHeight,
            windowOrientation: (window as any).orientation,
            matchMedia: typeof window.matchMedia === 'function' ? window.matchMedia('(orientation: landscape)').matches : 'no',
            orientActive: Main.Orientation.active,
            // ⚠️ canvas DOM 状态（定位画面旋转根因）
            canvasStyleTransform: canvasEl?.style?.transform || '(空)',
            canvasStyleW: canvasEl?.style?.width || '(空)',
            canvasStyleH: canvasEl?.style?.height || '(空)',
            canvasClientW: canvasEl?.clientWidth || -1,
            canvasClientH: canvasEl?.clientHeight || -1,
            canvasAttrW: canvasEl?.width || -1,        // 渲染 buffer 宽
            canvasAttrH: canvasEl?.height || -1,       // 渲染 buffer 高
            // ⚠️ cocos view 内部状态（确认引擎是否旋转了画面）
            viewIsRotated: view?._isRotated,
            viewScaleX: view?._scaleX,
            viewScaleY: view?._scaleY,
            viewFrameW: view?._frameSize?.width,
            viewFrameH: view?._frameSize?.height,
            viewVPRect: view?._viewportRect,
            resizeWithBrowserSize: view?._resizeWithBrowserSize,
            resizeFixCount: this._resizeFixCount,
        }));
    }

    /**
     * 检测软键盘是否大概率处于弹出状态
     *
     * 主信号：H5 层 focusin/focusout 驱动的 window.__TG_KEYBOARD_OPEN__ 标志（最可靠）
     * 阈值判断作为 fallback（非 TG 环境，或 TG 但 H5 还没设标志的边界情况）
     */
    private isKeyboardLikelyOpen(): boolean {
        // 主信号：TG 环境 focusin/focusout 驱动的全局标志（最可靠，不受机型/全屏状态/键盘高度影响）
        // 解决 iPad Air 等 TG 非全屏设备上 innerHeight/screen.height 阈值失效导致横屏遮罩误显示
        if ((window as any).__TG_KEYBOARD_OPEN__ === true) return true;
        // (a) visualViewport: 可视高度被压缩 25%+ (W3C 标准, 最准)
        const vv = (window as any).visualViewport;
        if (vv && window.innerHeight > 0 && vv.height / window.innerHeight < 0.75) {
            return true;
        }
        // (b) Telegram SDK: viewportHeight 比 stableHeight 小 50px+ (Telegram 专属最稳)
        const tg = (window as any).Telegram?.WebApp;
        if (tg && tg.viewportHeight != null && tg.viewportStableHeight != null
            && tg.viewportStableHeight - tg.viewportHeight > 50) {
            return true;
        }
        // (c) screen 兜底: 窗口高度被压缩到屏幕高度的 75% 以下
        if (window.screen && window.screen.height > 0
            && window.innerHeight / window.screen.height < 0.75) {
            return true;
        }
        return false;
    }

    /**
     * 判断设备是否处于真实横屏状态 (不受软键盘影响)
     * 多策略 fallback
     */
    private isDeviceLandscape(): boolean {
        // (0) 物理屏幕几何校验（终极兜底，最优先，零依赖）
        //   screen.width / screen.height 是物理屏幕尺寸，键盘弹出永远不变。
        //   如果物理屏幕是竖屏（width < height），绝不判为 landscape，
        //   拦截所有"键盘压缩 innerHeight 导致 matchMedia 误判"的情况。
        if (window.screen && window.screen.width > 0 && window.screen.height > 0
            && window.screen.width < window.screen.height) {
            return false;
        }
        // (a) screen.orientation.angle (W3C 推荐, 不受键盘影响)
        const so = (screen as any).orientation;
        if (so && typeof so.angle === 'number') {
            return so.angle === 90 || so.angle === 270;
        }
        // (b) window.orientation（基于物理传感器，不受键盘弹出影响）⚠️ 必须在 matchMedia 之前
        //     matchMedia 基于 innerWidth/innerHeight，键盘弹出 innerHeight 变小时会误判 landscape
        //     window.orientation 基于设备陀螺仪/加速计，键盘弹出时保持不变（竖屏=0）
        const wo = (window as any).orientation;
        if (typeof wo === 'number') {
            return wo === 90 || wo === -90;
        }
        // (c) matchMedia 兜底（键盘弹出时可能误判，仅在前两者都不可用时使用）
        if (typeof window.matchMedia === 'function') {
            return window.matchMedia('(orientation: landscape)').matches;
        }
        return false;
    }
}
