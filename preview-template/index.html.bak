<!--
 * @description: Cocos Creator 2.4.8 编辑器预览模板
 *               引擎会自动注入 cocos 引擎脚本，这里只需添加额外的 Web 层脚本
 * @FilePath: /pokerqueen/preview-templates/index.html
-->
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>PokerQueen - Preview</title>
    <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1, minimum-scale=1,maximum-scale=1" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">
    <meta name="renderer" content="webkit" />
    <meta name="force-rendering" content="webkit" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="msapplication-tap-highlight" content="no">
    <meta name="full-screen" content="yes" />
    <meta name="x5-fullscreen" content="true" />
    <meta name="360-fullscreen" content="true" />
    <meta name="screen-orientation" content="landscape" />
    <meta name="x5-orientation" content="landscape">
    <meta name="x5-page-mode" content="app">

    <link rel="icon" href="favicon.ico" />

    <!-- Telegram Web App SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <!-- 全屏样式优化 -->
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
        }
        #GameCanvas {
            width: 100% !important;
            height: 100vh !important;
            height: 100dvh !important;
            display: block;
        }
        body.telegram-app {
            -webkit-overflow-scrolling: touch;
            touch-action: none;
        }
    </style>

    <!-- Telegram 初始化 -->
    <script>
        (function() {
            if (window.Telegram && window.Telegram.WebApp) {
                const tg = window.Telegram.WebApp;
                document.body.classList.add('telegram-app');
                tg.ready();
                try { tg.expand(); } catch (e) {}
                setTimeout(function() { try { tg.expand(); } catch (e) {} }, 300);
            }
        })();
    </script>
</head>

<body>
    <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="0"></canvas>
    <canvas id="drawCanvas" style="display:none;"></canvas>
    <div id="splash"></div>

    <input id="OpenImageFile" type="file" accept=".png, .jpg, .jpeg" style="visibility: hidden">

    <!-- Cocos 引擎脚本由编辑器自动注入，不要手动添加 main.js / settings.js / cocos2d-js.js -->

    <!-- 额外的 Web 层脚本（构建时在 build-templates 中也有对应引用） -->
    <script src="bottom-bar.js" charset="utf-8"></script>
    <script src="https://download.agora.io/sdk/release/AgoraRTC_N.js"></script>

    <script>
        window.createVconsole = () => {
            if (typeof VConsole !== 'undefined') {
                window.vConsole = new VConsole();
            }
        }
    </script>
</body>

</html>
